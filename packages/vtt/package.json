{
  "name": "@react-av/vtt",
  "private": false,
  "version": "0.0.10",
  "description": "WebVTT support for React AV.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist/cjs",
    "dist/esm",
    "src"
  ],
  "scripts": {
    "build:cjs": "tsc --outDir dist/cjs --module commonjs",
    "build:esm": "tsc --outDir dist/esm --module esnext",
    "build": "pnpm build:cjs && pnpm build:esm",
    "dev": "tsc --watch"
  },
  "keywords": [],
  "author": "Daniel Wykerd <daniel@wykerd.dev>",
  "license": "MIT",
  "repository": {
    "directory": "packages/vtt",
    "type": "git",
    "url": "https://github.com/Wykerd/react-av.git"
  },
  "devDependencies": {
    "@react-av/core": "workspace:^",
    "@react-av/vtt-core": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@react-av/core": "workspace:^",
    "@react-av/vtt-core": "workspace:^",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  }
}

{
  "name": "@react-av/vtt-core",
  "version": "0.0.8",
  "private": false,
  "description": "W3C specification compliant WebVTT implementation.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "module": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/esm/node.d.ts",
          "default": "./dist/esm/node.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/*/renderer/*.js"
  ],
  "files": [
    "dist/cjs",
    "dist/esm",
    "src"
  ],
  "scripts": {
    "build:cjs": "tsc --outDir dist/cjs --module commonjs",
    "build:esm": "tsc --outDir dist/esm --module esnext && node -e \"fs.writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module', sideEffects: ['./renderer/*.js'] }))\"",
    "build": "pnpm build:cjs && pnpm build:esm && node ../../scripts/build-node-entry.mjs",
    "dev": "tsc --watch"
  },
  "keywords": [],
  "author": "Daniel Wykerd <daniel@wykerd.dev>",
  "license": "MIT",
  "repository": {
    "directory": "packages/vtt-core",
    "type": "git",
    "url": "https://github.com/Wykerd/react-av.git"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}

  },
  "devDependencies": {
    "@react-av/core": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shaka-player": "5.2.12",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@react-av/core": "workspace:^",
    "react": "^18.3.1 || ^19.0.0",

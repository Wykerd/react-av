---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/martian-mono';
import '../styles/tailwind.css';
import '../styles/landing.css';
import { Code } from 'astro:components';
import Schematic from '../components/Landing/Schematic.astro';
import Logo from '../components/Landing/Logo.astro';
import PlayerDemo from '../demos/PlayerDemo';
import EditorDemo from '../demos/EditorDemo';
import LyricsDemo from '../demos/LyricsDemo';
import ink from '../styles/shiki-ink.mjs';
import { SITE } from '../config';

const title = `${SITE.title} · Headless audio and video for React`;
const canonicalUrl = new URL('/', Astro.site);
const socialImage = new URL('/og-image.png', Astro.site);

const facts = [
	{ label: 'Headless', text: 'No CSS shipped. Every part takes your classes.' },
	{ label: 'WebVTT', text: 'Spec-based parser and renderer for captions.' },
	{ label: 'HLS + DASH', text: 'Adaptive streaming through Shaka Player.' },
	{ label: 'Typed', text: 'Written in TypeScript, declarations included.' },
];

const editorSnippet = `<Media.Root>
  <Track kind="subtitles" src="/lesson.vtt" id="captions" />
  <Editor mediaComponent={<Media.Video src="/lesson.mp4" />}>
    <TimelineEditor>
      <TimelineControlBar />
      <TimelineContainer>
        <TimelineHeader />
        <TimelineSubtitlesTrack id="captions">
          <TimelineSubtitleCueEditor />
        </TimelineSubtitlesTrack>
      </TimelineContainer>
    </TimelineEditor>
  </Editor>
</Media.Root>`;

const hookSnippet = `function Lyrics() {
  const [cues, active] = useMediaTextTrack("lyrics");
  const [, seek] = useMediaCurrentTime();

  return cues.map(cue => (
    <Cue as="li" cue={cue} key={cue.startTime}
      data-active={active.includes(cue)}
      onClick={() => seek(cue.startTime)} />
  ));
}`;

const packages = [
	{ name: 'core', text: 'Root, media elements, viewport and state hooks.', href: '/en/core-components' },
	{ name: 'controls', text: 'Play, mute, loop, fullscreen, PiP and timestamps.', href: '/en/controls' },
	{ name: 'sliders', text: 'Seek and volume sliders built on Radix UI.', href: '/en/sliders' },
	{ name: 'vtt-core', text: 'Standalone WebVTT parser and renderer.', href: '/en/webvtt' },
	{ name: 'vtt', text: 'Tracks, cues and caption overlays.', href: '/en/text-track-introduction' },
	{ name: 'vtt-controls', text: 'Storyboard thumbnails from WebVTT.', href: '/en/vtt-controls' },
	{ name: 'shaka', text: 'HLS and DASH playback via Shaka Player.', href: '/en/core-other-sources' },
	{ name: 'editor', text: 'Timeline and subtitle editing components.', href: 'https://github.com/Wykerd/react-av/tree/master/packages/editor' },
];

const github = 'https://github.com/Wykerd/react-av';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={SITE.description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#f3f1ea" />
		<meta name="color-scheme" content="light" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={SITE.description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body class="landing min-h-screen font-sans text-ink antialiased">
		<div class="mx-auto max-w-[1180px] border-x border-line">
			<header class="flex items-center justify-between border-b border-line px-5 py-4 sm:px-8">
				<a href="/" class="flex items-center gap-2.5 text-ink" aria-label="React AV home">
					<Logo class="size-6" />
					<span class="text-[15px] font-semibold tracking-tight">React AV</span>
				</a>
				<nav class="flex items-center gap-5 font-mono text-[10px] uppercase tracking-[0.14em] sm:gap-7">
					<a href="/en/introduction" class="underline-offset-4 hover:underline">Docs</a>
					<a href={github} class="underline-offset-4 hover:underline">GitHub</a>
					<a href="https://www.npmjs.com/package/@react-av/core" class="max-sm:hidden underline-offset-4 hover:underline">npm</a>
				</nav>
			</header>

			<main>
				<section class="grid items-center gap-12 px-5 pb-16 pt-14 sm:px-8 lg:grid-cols-[1.15fr_1fr] lg:gap-10 lg:pb-24 lg:pt-20">
					<div class="flex flex-col items-start">
						<p class="eyebrow rise" style="--delay: 0ms">Headless media toolkit for React</p>
						<h1 class="rise mt-5 text-[clamp(2.6rem,5.6vw,4.4rem)] font-semibold leading-[0.95] tracking-[-0.035em]" style="--delay: 80ms">
							Media players,<br />built to your spec.
						</h1>
						<p class="rise mt-6 max-w-[34rem] text-lg leading-relaxed text-ink-soft" style="--delay: 160ms">
							React AV handles playback state, captions, streaming and timeline editing. Compose it with hooks and unstyled components, and keep every pixel of the interface your own.
						</p>
						<div class="rise mt-9 flex w-full max-w-md items-stretch border border-ink bg-paper font-mono text-xs" style="--delay: 240ms">
							<span class="select-none border-r border-line px-3 py-3 text-ink-soft">$</span>
							<code class="grow overflow-x-auto whitespace-nowrap px-3 py-3">npm i @react-av/core</code>
							<button type="button" data-copy="npm i @react-av/core" class="border-l border-ink px-4 text-[10px] uppercase tracking-[0.14em] transition-colors hover:bg-ink hover:text-paper focus-visible:bg-ink focus-visible:text-paper focus-visible:outline-none">
								<span class="copy-label">Copy</span>
							</button>
						</div>
						<div class="rise mt-4 flex flex-wrap gap-3" style="--delay: 320ms">
							<a href="/en/introduction" class="bg-ink px-5 py-3 text-sm font-medium text-paper transition-colors hover:bg-signal">Read the docs</a>
							<a href={github} class="border border-ink px-5 py-3 text-sm font-medium transition-colors hover:bg-paper-deep">View on GitHub</a>
						</div>
					</div>
					<figure class="rise ticks p-4 sm:p-6" style="--delay: 200ms">
						<Schematic />
						<figcaption class="eyebrow mt-3 flex justify-between">
							<span>Fig. 00 · Anatomy of a player</span>
							<span class="max-sm:hidden">Scale 1:1</span>
						</figcaption>
					</figure>
				</section>

				<ul class="grid grid-cols-2 border-y border-line lg:grid-cols-4">
					{
						facts.map((fact, index) => (
							<li class:list={['flex flex-col gap-2 px-5 py-6 sm:px-8', index % 2 === 1 && 'border-l border-line', index >= 2 && 'max-lg:border-t max-lg:border-line', index === 2 && 'lg:border-l lg:border-line']}>
								<span class="eyebrow text-ink">{fact.label}</span>
								<span class="text-sm leading-snug text-ink-soft">{fact.text}</span>
							</li>
						))
					}
				</ul>

				<section id="player" class="grid gap-8 border-b border-line px-5 py-16 sm:px-8 lg:grid-cols-[15rem_1fr] lg:gap-12 lg:py-24">
					<div class="reveal flex flex-col gap-4 lg:sticky lg:top-8 lg:self-start">
						<span class="eyebrow">01 · Player</span>
						<h2 class="text-3xl font-semibold leading-tight tracking-tight">One player.<br />Any skin.</h2>
						<p class="text-[15px] leading-relaxed text-ink-soft">Three skins on one <code class="font-mono text-[12px] text-ink">&lt;Media.Root&gt;</code>. Switch while it plays: position, volume and captions carry over because only the markup changes.</p>
					</div>
					<div class="reveal">
						<PlayerDemo client:only="react" />
					</div>
				</section>

				<section id="editor" class="grid gap-8 border-b border-line px-5 py-16 sm:px-8 lg:grid-cols-[15rem_1fr] lg:gap-12 lg:py-24">
					<div class="reveal flex flex-col gap-4 lg:sticky lg:top-8 lg:self-start">
						<span class="eyebrow">02 · Editor</span>
						<h2 class="text-3xl font-semibold leading-tight tracking-tight">A timeline editor you can ship.</h2>
						<p class="text-[15px] leading-relaxed text-ink-soft">Subtitle editing as composable parts. Restyle it for a studio tool or a course builder without forking a line.</p>
						<p class="text-[15px] leading-relaxed text-ink-soft">Select a cue to edit it, drag across the track to add one, or use the arrow keys to nudge timing.</p>
					</div>
					<div class="reveal flex min-w-0 flex-col gap-6">
						<EditorDemo client:only="react" />
						<div class="code-block ticks">
							<p class="eyebrow border-b border-line px-6 py-3">editor.tsx</p>
							<Code code={editorSnippet} lang="tsx" theme={ink} />
						</div>
					</div>
				</section>

				<section id="hooks" class="grid gap-8 border-b border-line px-5 py-16 sm:px-8 lg:grid-cols-[15rem_1fr] lg:gap-12 lg:py-24">
					<div class="reveal flex flex-col gap-4 lg:sticky lg:top-8 lg:self-start">
						<span class="eyebrow">03 · Hooks</span>
						<h2 class="text-3xl font-semibold leading-tight tracking-tight">Sync anything to playback.</h2>
						<p class="text-[15px] leading-relaxed text-ink-soft">Every piece of media state is a hook. Lyrics, transcripts, quizzes, chapter lists: read the clock, render what you like.</p>
					</div>
					<div class="reveal flex min-w-0 flex-col gap-10">
						<LyricsDemo client:only="react" />
						<div class="code-block ticks">
							<p class="eyebrow border-b border-line px-6 py-3">lyrics.tsx</p>
							<Code code={hookSnippet} lang="tsx" theme={ink} />
						</div>
					</div>
				</section>

				<section id="packages" class="px-5 py-16 sm:px-8 lg:py-24">
					<div class="reveal mb-10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
						<div class="flex flex-col gap-4">
							<span class="eyebrow">04 · Packages</span>
							<h2 class="text-3xl font-semibold leading-tight tracking-tight">Take only what you need.</h2>
						</div>
						<a href="/en/introduction" class="font-mono text-[10px] uppercase tracking-[0.14em] underline-offset-4 hover:underline">All documentation →</a>
					</div>
					<ul class="reveal grid border-l border-t border-ink sm:grid-cols-2 lg:grid-cols-4">
						{
							packages.map(item => (
								<li class="border-b border-r border-ink">
									<a href={item.href} class="group flex h-full flex-col gap-6 p-5 transition-colors hover:bg-ink hover:text-paper">
										<span class="font-mono text-[11px]">
											<span class="text-ink-soft group-hover:text-paper/60">@react-av/</span>{item.name}
										</span>
										<span class="mt-auto text-sm leading-snug text-ink-soft group-hover:text-paper/80">{item.text}</span>
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</main>

			<footer class="grid gap-6 border-t border-line px-5 py-10 text-xs leading-relaxed text-ink-soft sm:px-8 md:grid-cols-2">
				<div class="flex flex-col gap-1">
					<span class="flex items-center gap-2 font-semibold text-ink"><Logo class="size-4" /> React AV</span>
					<span>By <a href="https://wykerd.dev" class="text-ink underline underline-offset-2">Daniel Wykerd</a> and <a href={`${github}/graphs/contributors`} class="text-ink underline underline-offset-2">contributors</a>. Released under the <a href={`${github}/blob/master/LICENSE`} class="text-ink underline underline-offset-2">MIT License</a>.</span>
				</div>
				<div class="flex flex-col gap-1 md:text-right">
					<span><a href="https://www.youtube.com/watch?v=_cMxraX_5RE" class="text-ink underline underline-offset-2">Sprite Fright</a> by <a href="https://studio.blender.org/" class="text-ink underline underline-offset-2">Blender Foundation</a>, <a href="https://creativecommons.org/licenses/by/1.0/" class="text-ink underline underline-offset-2">CC BY 1.0</a>.</span>
					<span><a href="https://lemondemon.bandcamp.com/album/dinosaurchestra" class="text-ink underline underline-offset-2">Fine</a> by <a href="http://www.neilcic.com/" class="text-ink underline underline-offset-2">Neil Cicierega (Lemon Demon)</a>, <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/" class="text-ink underline underline-offset-2">CC BY-NC-SA 3.0</a>.</span>
				</div>
			</footer>
		</div>

		<script>
			for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
				button.addEventListener('click', async () => {
					await navigator.clipboard.writeText(button.dataset.copy ?? '');
					button.dataset.copied = 'true';
					setTimeout(() => delete button.dataset.copied, 1600);
				});
			}
		</script>
	</body>
</html>
